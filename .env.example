# Postgres connection used by db/migrate.py, db/load.py and the engine.
# Local development (Homebrew Postgres, no password, socket connection):
DATABASE_URL=postgresql:///marginai

# Supabase (Project Settings -> Database -> Connection string -> Session pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres


# Phase 2+
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview
# Requests/minute cap shared across threads (0 = off); set just under your tier's limit, e.g. 12 on free tier
# GEMINI_RPM=0
# Retries per model on 429/5xx before falling back (the server's retryDelay is honoured, capped at 60 s)
# GEMINI_MAX_RETRIES=3
