# Postgres connection used by db/migrate.py, db/load.py and the engine.
# Local development (Homebrew Postgres, no password, socket connection):
DATABASE_URL=postgresql:///marginai

# Supabase (Project Settings -> Database -> Connection string -> Session pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres


# Phase 2+
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Requests/minute cap shared across threads (0 = off); set just under your tier's limit, e.g. 12 on free tier
# GEMINI_RPM=0
# Retries per model on 429/5xx before falling back (the server's retryDelay is honoured, capped at 60 s)
# GEMINI_MAX_RETRIES=3
# GEMINI_THINKING_LEVEL=minimal   # for thinking models (e.g. gemini-3.5-flash): far lower latency

# --- Shopify connection (see README: "Connect a Shopify store") ---
# From the Dev Dashboard: your app's Client ID and Client secret. Never commit or paste these anywhere.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Only these stores may complete an install (comma separated myshopify.com domains).
# SHOPIFY_ALLOWED_SHOPS=
# Comma-separated permissions requested at install (defaults to read orders/products/customers/inventory/locations/discounts).
# SHOPIFY_SCOPES=
# Public https URL Shopify redirects back to: a tunnel URL while a store owner installs, e.g. https://xxxx.trycloudflare.com
# APP_BASE_URL=http://localhost:8000
# Encrypts stored Shopify tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
# Set to 1 on the public deployment: only the synthetic demo store is visible or queryable.
# PUBLIC_DEMO=1

# --- Scale and freshness ---
# Minutes between automatic syncs of every connected Shopify store (0/unset = off). Runs inside the API process.
# SYNC_INTERVAL_MINUTES=15
# Include shipping province (protected customer data) in synced orders: 1 to enable.
# SHOPIFY_SYNC_ADDRESSES=0
# A catalogue bigger than this is searched per question instead of listed in every prompt.
# CATALOGUE_FULL_MAX=150
# How long a live store's prompt (today's date, catalogue, codes) is reused before it is rebuilt.
# CONTEXT_TTL_SECONDS=600

# --- Sign in with Google and store access ---
# OAuth client ID (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application).
# It is not secret. Leave empty to run without sign-in (local use only).
# GOOGLE_CLIENT_ID=
# Signs the login cookie. At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# Emails that can open every store, comma separated.
# ADMIN_EMAILS=you@example.com
# Set to 1 on a real public deployment (turns off the localhost-only guard). Real stores then require sign-in.
# ALLOW_PUBLIC_HOSTS=1
