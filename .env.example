# Postgres connection used by db/migrate.py, db/load.py and the engine.
# Local development (Homebrew Postgres, no password, socket connection):
DATABASE_URL=postgresql:///marginai

# Supabase (Project Settings -> Database -> Connection string -> Session pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Read-only role the query engine connects with (see db/migrations/002_readonly_role.sql).
# READONLY_DATABASE_URL=postgresql://marginai_readonly:<password>@localhost:5432/marginai

# Phase 2+
# GEMINI_API_KEY=
